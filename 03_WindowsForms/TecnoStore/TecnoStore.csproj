<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Forms en .NET Framework 4.8: viene instalado en Windows 10/11
       y usa System.Data.SqlClient sin paquetes NuGet extra.
       Requiere Visual Studio 2019/2022 con la carga "Desarrollo de escritorio de .NET". -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>TecnoStore</RootNamespace>
    <AssemblyName>TecnoStore</AssemblyName>
    <ApplicationIcon />
    <StartupObject>TecnoStore.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

</Project>
