<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!--
      ModoConexion:
        Roles  -> cada perfil se conecta con su propio login de SQL Server
                  (tecno_admin, tecno_supervisor, tecno_operador, tecno_consulta),
                  así los permisos de 07_Seguridad.sql se aplican de verdad.
                  Requiere autenticación de SQL Server (modo mixto) y haber
                  ejecutado 07_Seguridad.sql.
        Unica  -> todos usan la cadena "Unica" (p. ej. autenticación de Windows).
                  Útil si su SQL Server solo acepta autenticación de Windows;
                  los permisos por perfil los controla solo la aplicación.
    -->
    <add key="ModoConexion" value="Unica" />
  </appSettings>

  <connectionStrings>
    <!-- Cambien "Server" por su instancia: localhost, .\SQLEXPRESS, (localdb)\MSSQLLocalDB, etc. -->
    <add name="Unica"      connectionString="Server=localhost;Database=TecnoStore;Integrated Security=True" />

    <add name="Login"      connectionString="Server=localhost;Database=TecnoStore;User Id=tecno_login;Password=Tecno#2026sql" />
    <add name="Administrador" connectionString="Server=localhost;Database=TecnoStore;User Id=tecno_admin;Password=Tecno#2026sql" />
    <add name="Supervisor" connectionString="Server=localhost;Database=TecnoStore;User Id=tecno_supervisor;Password=Tecno#2026sql" />
    <add name="Operador"   connectionString="Server=localhost;Database=TecnoStore;User Id=tecno_operador;Password=Tecno#2026sql" />
    <add name="Consulta"   connectionString="Server=localhost;Database=TecnoStore;User Id=tecno_consulta;Password=Tecno#2026sql" />
  </connectionStrings>
</configuration>
